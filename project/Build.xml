<?xml version="1.0" encoding="utf-8" ?>

<xml>
  <pragma once="true" />
  
  <include name="${HXCPP}/build-tool/BuildCommon.xml"/>
  
  <files id="common">
    
    <compilerflag value="-I${haxelib:extension-appodeal}/project/include" />
    <compilerflag value="-Iinclude"/>
    <compilerflag value="-DHXCPP_GC_CHECK_POINTER"/>

    <file name="common/ExternalInterface.cpp"/>
  </files>

  <files id="iphone">
    
    <compilerflag value="-I${haxelib:extension-appodeal}/project/include" />
    <compilerflag value="-DHXCPP_GC_CHECK_POINTER"/>

    <compilerflag value="-DAPPODEAL_INIT_FIREBASE" if="APPODEAL_INIT_FIREBASE"/>

    <section if="iphoneos">
      <compilerflag value="-F${haxelib:extension-appodeal}/dependencies/ios/Appodeal.xcframework/ios-arm64/"/>
      <compilerflag value="-F${haxelib:extension-appodeal}/dependencies/ios/FirebaseCore.xcframework/ios-arm64/" if="APPODEAL_INIT_FIREBASE"/>
    </section>

    <section if="iphonesim || simulator">
      <compilerflag value="-F${haxelib:extension-appodeal}/dependencies/ios/Appodeal.xcframework/ios-arm64_x86_64-simulator/"/>
      <compilerflag value="-F${haxelib:extension-appodeal}/dependencies/ios/FirebaseCore.xcframework/ios-arm64_x86_64-simulator/" if="APPODEAL_INIT_FIREBASE"/>
    </section>

    <compilerflag value="-IiPhone/include"/>
    <compilerflag value="-Iinclude"/>
    <compilerflag value="-F${haxelib:extension-appodeal}/dependencies/ios" />
    
    <file name="iphone/AppodealExtension.mm"/>
    
  </files>
  
  <set name="SLIBEXT" value=".lib" if="windows"/>
  <set name="SLIBEXT" value=".a" unless="windows"/>
  <set name="SLIBEXT" value=".so" if="webos"/>
  
  <set name="DEBUGEXTRA" value="-debug" if="fulldebug" />
  
  <target id="NDLL" output="${LIBPREFIX}appodeal${MSVC_LIB_VERSION}${DEBUGEXTRA}${LIBEXTRA}" tool="linker" toolid="${STD_MODULE_LINK}">
    
    <outdir name="../ndll/${BINDIR}"/>
    <ext value=".ndll" if="windows || mac || linux"/>
    <vflag name="-framework" value="Appodeal" />
    <vflag name="-framework" value="FirebaseCore" if="APPODEAL_INIT_FIREBASE"/>
    <files id="common"/>
    <files id="iphone" if="iphone"/>
  </target>
  
  <target id="default">
    
    <target id="NDLL"/>
    
  </target>
  
</xml>
